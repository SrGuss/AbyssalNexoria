# Copie este arquivo para .env. Nunca versione o .env.
OWNER_NICK=SeuNickDeDono
OWNER_EMAIL=voce@exemplo.com
OWNER_WHATSAPP=5511999999999
# Gere com: node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log('ADMIN_PASSWORD_SALT='+s+'\nADMIN_PASSWORD_HASH='+c.pbkdf2Sync('SUA_SENHA',s,310000,32,'sha256').toString('hex'))"
OWNER_PASSWORD_SALT=
OWNER_PASSWORD_HASH=
# Em desenvolvimento, o código 2FA WhatsApp aparece somente no terminal da API.
NODE_ENV=development
# Gere uma chave longa e exclusiva para o plugin de login (não compartilhe).
PLUGIN_LOGIN_KEY=
# Chave exclusiva do NexoriaBridge. Não reutilize a chave de login.
PLUGIN_BRIDGE_KEY=
